{
  "manifest_version": 3,
  "name": "Creulette tracker",
  "version": "1.0",
  "description": "A tool to track your Creulette rolls!",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://prototypestudios.neocities.org/creulette"],
      "js": ["content.js"]
    }
  ]
}